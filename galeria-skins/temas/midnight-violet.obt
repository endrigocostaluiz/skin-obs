@OBSThemeMeta {
    name: 'Midnight Creator';
    id: 'com.lumina.midnightviolet';
    extends: 'com.obsproject.Yami';
    author: 'Lumina Studio Design Team';
    dark: 'true';
}

@OBSThemeVars {
    /* Escala neutra (superfÃ­cies, bordas, botÃµes) */
    --grey8: #07050E;
    --grey7: #0D0A18;
    --grey6: #130F22;
    --grey5: #1C1730;
    --grey4: #272044;
    --grey3: #372D5E;
    --grey2: #4D3E82;
    --grey1: #6D5BB6;

    /* Cor de destaque */
    --blue1: #B495F9;
    --blue2: #A079F8;
    --blue3: #8B5CF6;
    --blue4: #764ED1;
    --blue5: #6140AC;
    --blue6: #4C3387;
    --primary: #8B5CF6;
    --primary_light: #A079F8;
    --primary_lighter: #B495F9;
    --primary_dark: #764ED1;
    --primary_darker: #6140AC;

    --bg_window: #0D0A18;
    --bg_base: #130F22;
    --bg_preview: #07050E;

    --text: #FAF5FF;
    --text_light: #FAF5FF;
    --text_muted: #A78BFA;
    --text_disabled: #A78BFA;
    --text_inactive: #A78BFA;

    --border_color: #272044;
    --border_radius: 6px;
    --border_radius_small: 4px;
    --border_radius_large: 8px;

    --input_bg: #1C1730;
    --input_bg_hover: #272044;
    --input_bg_focus: #130F22;
    --input_border: #272044;
    --input_border_hover: #4D3E82;
    --input_border_focus: #8B5CF6;

    --button_bg: #1C1730;
    --button_bg_hover: #272044;
    --button_bg_down: #0D0A18;
    --button_bg_disabled: #130F22;
    --button_border: #272044;
    --button_border_hover: #8B5CF6;
    --button_border_focus: #8B5CF6;

    --list_item_bg_selected: #261B44;
    --list_item_bg_hover: #1C1730;

    --tab_bg: #130F22;
    --tab_bg_hover: #1C1730;
    --tab_bg_down: #8B5CF6;
    --tab_border: #272044;
    --tab_border_selected: #8B5CF6;
    --tab_border_focus: #B495F9;

    --scrollbar_bg: #0D0A18;
    --scrollbar_handle: #272044;
    --scrollbar_hover: #372D5E;
    --scrollbar_down: #8B5CF6;

    --highlight_color: #8B5CF6;

    --palette_window: #0D0A18;
    --palette_base: #130F22;
    --palette_highlight: #8B5CF6;
    --palette_highlightedText: #FFFFFF;
}


/* ====================================================================
   MIDNIGHT CREATOR - PadrÃ£o visual idÃªntico ao preview da galeria
   Fonte: Plus Jakarta Sans (fallback Segoe UI) | Ãcones: Lucide
   ==================================================================== */

QWidget {
    font-family: "Plus Jakarta Sans", "Segoe UI", "Inter", sans-serif;
}

/* ---------- Docks ---------- */
QDockWidget::title {
    background-color: #1C1730;
    color: #FAF5FF;
    padding: 7px 10px;
    font-weight: 700;
    border-bottom: 1px solid #272044;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

OBSDock > QWidget, OBSDock QAbstractScrollArea {
    background-color: #130F22;
}

/* ---------- Listas: Cenas e Fontes ---------- */
QListView, QListWidget, SceneTree, SourceTree {
    background-color: #0D0A18;
    border: 1px solid #272044;
    border-radius: 6px;
    padding: 3px;
}

QListView::item, QListWidget::item, SceneTree::item {
    padding: 7px 9px;
    margin: 0px;
    border-radius: 6px;
    border: 1.5px solid transparent;
    color: #FAF5FF;
    font-weight: 600;
    font-size: var(--font_large);
}

QListView::item:hover:!selected, QListWidget::item:hover:!selected, SceneTree::item:hover:!selected {
    background-color: #1C1730;
    border: 1.5px solid #272044;
}

QListView::item:selected, QListWidget::item:selected, SceneTree::item:selected,
.list-grid SceneTree::item:selected, .list-grid SceneTree::item:checked {
    background-color: #261B44;
    border: 1.5px solid #8B5CF6;
    color: #FFFFFF;
    font-weight: 700;
}

QListView::item:selected:hover, QListWidget::item:selected:hover, SceneTree::item:selected:hover {
    background-color: #302155;
    border: 1.5px solid #A079F8;
}

.list-grid SceneTree::item {
    background-color: #1C1730;
    border: 1.5px solid #272044;
    border-radius: 6px;
}

/* O item de Fontes é um widget (SourceTreeItem) desenhado sobre a linha: a linha não pode ter
   padding/margem, senão o hover/seleção fica deslocado ou pela metade */
SourceTree::item, SourceTree::item:hover, SourceTree::item:selected, SourceTree::item:selected:hover {
    padding: 0px;
    margin: 0px;
    min-height: 32px;
}
SourceTreeItem {
    padding: 5px 6px;
    margin: 0px;
    border-radius: 6px;
    border: 0px solid transparent;
    font-size: var(--font_large);
    min-height: 0px; /* o widget se ajusta à linha (32px); nada pode ser mais alto que ela, senão o conteúdo escorrega */
    font-weight: 600;
}
SourceTreeItem QLabel { font-size: var(--font_large); font-weight: 600; }
.checkbox-icon { padding: 2px; margin-top: 0px; margin-bottom: 0px; }

/* Foco (clique/teclado): o OBS usa borda BRANCA aqui; troca pela cor do tema (ex.: menu Configurações) */
QListView::item:focus:!selected, QListWidget::item:focus:!selected, SceneTree::item:focus:!selected { border: 1.5px solid transparent; }
QListView::item:selected:focus, QListWidget::item:selected:focus, SceneTree::item:selected:focus { border: 1.5px solid #8B5CF6; }
QMenu::item:focus, QMenu::item:selected:focus { border: 0px solid transparent; border-left: 3px solid #8B5CF6; }

/* Fonte selecionada: mesma borda/tint do tema, com ou sem foco (sem isso o OBS deixa branca ao perder o foco) */
SourceTree::item:selected, SourceTree::item:selected:!focus, SourceTree::item:selected:!active, SourceTree::item:selected:focus {
    background-color: #261B44;
    border: 1.5px solid #8B5CF6;
}
SourceTree::item:selected:hover { background-color: #302155; border: 1.5px solid #A079F8; }
QListView::item:selected:!focus, QListWidget::item:selected:!focus, SceneTree::item:selected:!focus,
QListView::item:selected:!active, QListWidget::item:selected:!active, SceneTree::item:selected:!active {
    background-color: #261B44;
    border: 1.5px solid #8B5CF6;
}


/* Olho, cadeado e seta de grupo (Ã­cones prÃ³prios do tema) */
.checkbox-icon:hover, .checkbox-icon:focus {
    border-color: #372D5E;
    background: #1C1730;
}
.indicator-visibility::indicator:checked, .indicator-visibility::indicator:checked:hover { image: url(theme:Lumina-midnight-violet/visible.svg); }
.indicator-visibility::indicator:unchecked, .indicator-visibility::indicator:unchecked:hover { image: url(theme:Lumina-midnight-violet/invisible.svg); }
.indicator-lock::indicator:checked, .indicator-lock::indicator:checked:hover { image: url(theme:Lumina-midnight-violet/locked.svg); }
.indicator-lock::indicator:unchecked, .indicator-lock::indicator:unchecked:hover { image: url(theme:Lumina-midnight-violet/unlocked.svg); }
.indicator-expand::indicator:checked, .indicator-expand::indicator:checked:hover { image: url(theme:Lumina-midnight-violet/expand.svg); }
.indicator-expand::indicator:unchecked, .indicator-expand::indicator:unchecked:hover { image: url(theme:Lumina-midnight-violet/collapse.svg); }

/* Ãcones por tipo de fonte (lidos pelo OBS a partir do tema) */
OBSBasic {
    qproperty-imageIcon: url(theme:Lumina-midnight-violet/sources/image.svg);
    qproperty-colorIcon: url(theme:Lumina-midnight-violet/sources/brush.svg);
    qproperty-slideshowIcon: url(theme:Lumina-midnight-violet/sources/slideshow.svg);
    qproperty-audioInputIcon: url(theme:Lumina-midnight-violet/sources/microphone.svg);
    qproperty-audioOutputIcon: url(theme:Lumina-midnight-violet/sources/audio.svg);
    qproperty-desktopCapIcon: url(theme:Lumina-midnight-violet/sources/video.svg);
    qproperty-windowCapIcon: url(theme:Lumina-midnight-violet/sources/window.svg);
    qproperty-gameCapIcon: url(theme:Lumina-midnight-violet/sources/gamepad.svg);
    qproperty-cameraIcon: url(theme:Lumina-midnight-violet/sources/camera.svg);
    qproperty-textIcon: url(theme:Lumina-midnight-violet/sources/text.svg);
    qproperty-mediaIcon: url(theme:Lumina-midnight-violet/sources/media.svg);
    qproperty-browserIcon: url(theme:Lumina-midnight-violet/sources/globe.svg);
    qproperty-groupIcon: url(theme:Lumina-midnight-violet/sources/group.svg);
    qproperty-sceneIcon: url(theme:Lumina-midnight-violet/sources/scene.svg);
    qproperty-defaultIcon: url(theme:Lumina-midnight-violet/sources/default.svg);
    qproperty-audioProcessOutputIcon: url(theme:Lumina-midnight-violet/sources/windowaudio.svg);
}

/* ---------- Mixer de Ã¡udio ---------- */
#stackedMixerArea, #vMixerScrollArea, #hMixerScrollArea {
    background-color: #0D0A18;
}

VolumeControl {
    background-color: #130F22;
    border: 1px solid #272044;
    border-radius: 8px;
    margin: 3px 4px;
    padding: 4px 6px;
}

VolumeControl .mixer-category,
VolumeControl.volume-pinned .mixer-category {
    background: #1C1730;
    color: #8B5CF6;
    border-bottom: 2px solid #8B5CF6;
    font-weight: 700;
    border-radius: 3px;
}

VolumeControl .mixer-name, VolumeName QLabel {
    color: #FAF5FF;
    font-weight: 700;
}

/* Valor em dB como "pÃ­lula" */
VolumeControl #volLabel {
    background: #1C1730;
    border: 1px solid #272044;
    border-radius: 6px;
    color: #FAF5FF;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-weight: 700;
    padding: 2px 6px;
}

/* Medidor VU: verde -> amarelo -> vermelho sobre fundo escuro */
VolumeMeter {
    background: #130F22;
    qproperty-backgroundNominalColor: #07050E;
    qproperty-backgroundWarningColor: #07050E;
    qproperty-backgroundErrorColor: #07050E;
    qproperty-foregroundNominalColor: #06B6D4;
    qproperty-foregroundWarningColor: #EC4899;
    qproperty-foregroundErrorColor: #EF4444;
    qproperty-magnitudeColor: #FAF5FF;
    qproperty-majorTickColor: #A78BFA;
    qproperty-minorTickColor: #372D5E;
}

/* ---------- Sliders (fader do mixer, duraÃ§Ã£o, etc.) ---------- */
QSlider::groove:horizontal { background: #272044; height: 4px; border-radius: 2px; border: none; }
QSlider::groove:vertical   { background: #272044; width: 4px;  border-radius: 2px; border: none; }
QSlider::sub-page:horizontal { background: #8B5CF6; border-radius: 2px; }
QSlider::add-page:vertical   { background: #8B5CF6; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #8B5CF6;
    border: 2px solid #B495F9;
    width: 12px; height: 12px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:vertical {
    background: #8B5CF6;
    border: 2px solid #B495F9;
    width: 12px; height: 12px;
    margin: 0 -6px;
    border-radius: 8px;
}
QSlider::handle:hover   { background: #A079F8; }
QSlider::handle:pressed { background: #764ED1; }

/* ---------- BotÃµes ---------- */
QPushButton {
    background-color: #1C1730;
    border: 1px solid #272044;
    border-radius: 6px;
    color: #FAF5FF;
    font-weight: 600;
}
QPushButton:hover { background-color: #272044; border-color: #8B5CF6; color: #B495F9; }
QPushButton:pressed { background-color: #0D0A18; border-color: #764ED1; }
QPushButton:checked { background-color: #261B44; border: 1.5px solid #8B5CF6; color: #FFFFFF; font-weight: 700; }
QPushButton:disabled { background-color: #130F22; border-color: #1C1730; color: #A78BFA; }

/* BotÃ£o principal "Executar" / transiÃ§Ã£o */
#transitionButton, QPushButton[class~="btn-primary"], .button-primary {
    background-color: #8B5CF6;
    color: #FFFFFF;
    border: none;
    font-weight: 800;
}
#transitionButton:hover, .button-primary:hover { background-color: #A079F8; color: #FFFFFF; }

/* ---------- Controles (Ã­cone + texto, como no preview) ---------- */
#controlsFrame QPushButton {
    text-align: left;
    padding: 7px 12px;
    icon-size: 16px;
}
#streamButton      { qproperty-icon: url(theme:Lumina-midnight-violet/btn/stream.svg); }
#recordButton      { qproperty-icon: url(theme:Lumina-midnight-violet/btn/record.svg); }
#virtualCamButton  { qproperty-icon: url(theme:Lumina-midnight-violet/btn/virtualcam.svg); }
#modeSwitch        { qproperty-icon: url(theme:Lumina-midnight-violet/btn/studio.svg); }
#settingsButton    { qproperty-icon: url(theme:Lumina-midnight-violet/btn/settings.svg); }
#exitButton        { qproperty-icon: url(theme:Lumina-midnight-violet/btn/exit.svg); }

#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active {
    background-color: #8B5CF6;
    border-color: #8B5CF6;
    color: #FFFFFF;
}

/* ---------- Campos, combos e caixas ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #1C1730;
    border: 1px solid #272044;
    border-radius: 6px;
    color: #FAF5FF;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #8B5CF6; }
QComboBox QAbstractItemView {
    background-color: #130F22;
    border: 1px solid #272044;
    selection-background-color: #261B44;
    selection-color: #FAF5FF;
}

/* ---------- Menus, abas, barra de status ---------- */
QMenuBar::item:selected { background-color: #1C1730; color: #B495F9; border-radius: 6px; }
QMenu { background-color: #130F22; border: 1px solid #272044; border-radius: 6px; }
QMenu::item:selected { background-color: #261B44; color: #FAF5FF; border-left: 3px solid #8B5CF6; }

QTabBar::tab:selected { color: #8B5CF6; border-bottom: 2px solid #8B5CF6; font-weight: 700; }

OBSBasicStatusBar { background: #0D0A18; border-top: 1px solid #272044; }
QStatusBar QLabel, StatusBarWidget QLabel {
    font-family: "JetBrains Mono", "Consolas", monospace;
    color: #A78BFA;
}

/* ---------- Barras de rolagem finas ---------- */
QScrollBar::handle { border-radius: 3px; }
QScrollBar::handle:hover { background: #8B5CF6; }
